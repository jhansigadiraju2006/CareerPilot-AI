# Optional environment configuration. Copy values into your shell environment as needed.
CAREERPILOT_SECRET=replace-with-a-long-random-secret-before-deployment
CAREERPILOT_MODEL=llama3.2:3b
CAREERPILOT_DEBUG=false
CAREERPILOT_COOKIE_SECURE=false  # set true only when deployed behind HTTPS
# Optional: override the default local SQLite and knowledge paths.
# CAREERPILOT_DB_PATH=C:/path/to/careerpilot.db
# CAREERPILOT_KNOWLEDGE_DIR=C:/path/to/knowledge
